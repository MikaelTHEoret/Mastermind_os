{
  "sqlite": {
    "enabled": true,
    "database": "codex_memory.db",
    "tables": [
      "memory",
      "collections",
      "collection_items"
    ]
  },
  "keyValue": {
    "enabled": true,
    "database": "kv_store.db"
  },
  "vector": {
