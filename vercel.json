{  
  "version": 2,  
  "projectSettings": {  
    "framework": "nextjs"  
  },  
  "outputDirectory": ".next",  
  "buildCommand": "cd cosmogram-frontend && npm install && npm run build",  
  "installCommand": "cd cosmogram-frontend && npm install",  
  "rewrites": [  
    { "source": "/(.*)", "destination": "/cosmogram-frontend/$1" }  
  ]  
} 
